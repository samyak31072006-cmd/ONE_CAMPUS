# ==========================================
# CampusOne — Environment Configuration
# ==========================================
# PLACEHOLDERS ONLY - DO NOT COMMIT REAL SECRETS

# 1. Supabase Project Credentials (Server & Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. College Portal Adapter (SIS / ERP Integration)
COLLEGE_ERP_PROVIDER=development
COLLEGE_ERP_API_URL=https://erp.college.edu/api/v2
COLLEGE_ERP_CLIENT_ID=your-erp-client-id
COLLEGE_ERP_CLIENT_SECRET=your-erp-client-secret

# 5. Storage Bucket Configuration
NEXT_PUBLIC_STORAGE_BUCKET_EXEMPTIONS=exemption-documents
